<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>theknife</groupId>
    <artifactId>theknife-parent</artifactId>
    <version>1.0-SNAPSHOT</version>

    <packaging>pom</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>theknife-common</module>
        <module>theknife-server</module>
        <module>theknife-client</module>
    </modules>

    <build>
        <plugins>
            <!-- Sincronizza automaticamente src/ (bundle di consegna in
                 radice, richiesto dalla consegna) con i sorgenti reali dei
                 tre moduli, a ogni build ("mvn clean package" o qualunque
                 altro comando Maven, essendo legata alla phase initialize,
                 tra le primissime del lifecycle). Evita che src/ resti
                 disallineato dal codice effettivo se qualcuno dimentica di
                 aggiornarlo a mano — src/ non è mai la fonte reale del
                 codice (quella resta in theknife-common/, theknife-server/,
                 theknife-client/, dove Maven compila davvero): è solo lo
                 specchio che la consegna richiede nella cartella radice. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>sincronizza-src-common</id>
                        <phase>initialize</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/src/theknife-common/main/java</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/theknife-common/src/main/java</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>sincronizza-src-server</id>
                        <phase>initialize</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/src/theknife-server/main/java</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/theknife-server/src/main/java</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>sincronizza-src-client-java</id>
                        <phase>initialize</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/src/theknife-client/main/java</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/theknife-client/src/main/java</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>sincronizza-src-client-resources</id>
                        <phase>initialize</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/src/theknife-client/main/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/theknife-client/src/main/resources</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JavaDoc di tutti e 3 i moduli in un'unica documentazione HTML.
                 Non è legata a nessuna phase (non gira automaticamente con
                 "mvn package"): si genera esplicitamente con
                     mvn javadoc:aggregate
                 Output in target/site/apidocs, da qui copiato in doc/javadoc/
                 per la consegna. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <show>private</show>
                    <doclint>all</doclint>
                    <windowtitle>TheKnife — JavaDoc</windowtitle>
                    <doctitle>TheKnife — Documentazione JavaDoc</doctitle>
                    <failOnError>true</failOnError>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
