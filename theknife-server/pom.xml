<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>theknife</groupId>
        <artifactId>theknife-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>theknife-server</artifactId>

    <dependencies>
        <dependency>
            <groupId>theknife</groupId>
            <artifactId>theknife-common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        
        <!-- Driver PostgreSQL per la connessione al database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>
        <dependency>
            <groupId>at.favre.lib</groupId>
            <artifactId>bcrypt</artifactId>
            <version>0.10.2</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>serverTK</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>

                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>theknife.server.TheKnifeServer</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Crea il database dbTK (ruolo tk_app, tabelle, dataset di ristoranti).
             Non gira sulla build normale (compile/package): si lancia a parte,
             dalla radice del progetto, con
                 mvn initialize -Pdb-setup -Ddb.admin.user=<utente admin Postgres> -Ddb.admin.password=<password>
             Facoltativi: -Ddb.host (default localhost), -Ddb.port (default 5432).
             L'utente admin deve poter creare ruoli e database (es. l'utente
             "postgres" creato dall'installazione di PostgreSQL). Per gli
             utenti/servizi/recensioni di prova (facoltativi), si veda il
             profilo db-test-data qui sotto. -->
        <profile>
            <id>db-setup</id>
            <properties>
                <db.host>localhost</db.host>
                <db.port>5432</db.port>
                <db.sql.role>${project.basedir}/../Progettazione/Database/Role.sql</db.sql.role>
                <db.sql.schema>${project.basedir}/../Progettazione/Database/Schema.sql</db.sql.schema>
                <db.sql.data>${project.basedir}/../Progettazione/Database/Data.sql</db.sql.data>
                <db.name>dbTK</db.name>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>sql-maven-plugin</artifactId>
                        <version>1.5</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.postgresql</groupId>
                                <artifactId>postgresql</artifactId>
                                <version>42.7.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <driver>org.postgresql.Driver</driver>
                            <username>${db.admin.user}</username>
                            <password>${db.admin.password}</password>
                            <autocommit>true</autocommit>
                        </configuration>
                        <executions>
                            <!-- Role.sql va eseguito connessi al database di
                                 manutenzione "postgres": crea lui il ruolo
                                 tk_app e il database dbTK, che a questo punto
                                 non esistono ancora. -->
                            <execution>
                                <id>crea-ruolo-e-database</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>execute</goal>
                                </goals>
                                <configuration>
                                    <url>jdbc:postgresql://${db.host}:${db.port}/postgres</url>
                                    <srcFiles>
                                        <srcFile>${db.sql.role}</srcFile>
                                    </srcFiles>
                                </configuration>
                            </execution>
                            <!-- Schema.sql e Data.sql vanno eseguiti connessi
                                 al database dbTK appena creato dall'execution
                                 precedente. -->
                            <execution>
                                <id>crea-schema-e-dati</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>execute</goal>
                                </goals>
                                <configuration>
                                    <url>jdbc:postgresql://${db.host}:${db.port}/${db.name}</url>
                                    <srcFiles>
                                        <srcFile>${db.sql.schema}</srcFile>
                                        <srcFile>${db.sql.data}</srcFile>
                                    </srcFiles>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Carica gli utenti/servizi/recensioni di prova (facoltativo, solo
             per provare subito l'applicazione senza registrarsi/inserire
             dati a mano). Va lanciato DOPO db-setup, quando dbTK esiste già:
                 mvn initialize -Pdb-test-data
             Si connette come utente applicativo tk_app (stessa password
             fissa TheKnife-B usata dal server, si veda il Manuale Utente):
             gli INSERT di questi script rientrano nei permessi già concessi
             a tk_app da Schema.sql, non serve l'utente admin. -->
        <profile>
            <id>db-test-data</id>
            <properties>
                <db.host>localhost</db.host>
                <db.port>5432</db.port>
                <db.name>dbTK</db.name>
                <db.sql.dataUtentiTest>${project.basedir}/../Progettazione/Database/DataUtentiTest.sql</db.sql.dataUtentiTest>
                <db.sql.abilitaServiziTest>${project.basedir}/../Progettazione/Database/AbilitaServiziTest.sql</db.sql.abilitaServiziTest>
                <db.sql.popolaRecensioniTest>${project.basedir}/../Progettazione/Database/PopolaRecensioniTest.sql</db.sql.popolaRecensioniTest>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>sql-maven-plugin</artifactId>
                        <version>1.5</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.postgresql</groupId>
                                <artifactId>postgresql</artifactId>
                                <version>42.7.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <driver>org.postgresql.Driver</driver>
                            <url>jdbc:postgresql://${db.host}:${db.port}/${db.name}</url>
                            <username>tk_app</username>
                            <password>TheKnife-B</password>
                            <autocommit>true</autocommit>
                        </configuration>
                        <executions>
                            <!-- Ordine obbligato: PopolaRecensioniTest.sql fa
                                 riferimento agli utenti creati da
                                 DataUtentiTest.sql. -->
                            <execution>
                                <id>carica-dati-di-prova</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>execute</goal>
                                </goals>
                                <configuration>
                                    <srcFiles>
                                        <srcFile>${db.sql.dataUtentiTest}</srcFile>
                                        <srcFile>${db.sql.abilitaServiziTest}</srcFile>
                                        <srcFile>${db.sql.popolaRecensioniTest}</srcFile>
                                    </srcFiles>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
