<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>theknife</groupId>
        <artifactId>theknife-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>theknife-client</artifactId>

    <dependencies>
        <dependency>
            <groupId>theknife</groupId>
            <artifactId>theknife-common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- javafx-base, javafx-graphics, javafx-controls e javafx-fxml
             sono dichiarate esplicitamente una volta per ciascuna
             piattaforma target (win, mac-aarch64, linux), invece che
             senza classifier: senza, Maven risolve in automatico solo le
             native del sistema operativo di chi compila, e il jar shaded
             risultante funziona solo su quell'OS (bug reale riscontrato:
             clientTK.jar compilato su macOS non si avviava su Windows).
             Le native vere e proprie (prism, glass, ...) stanno in
             javafx-base/javafx-graphics, non in javafx-controls/-fxml
             (che sono puro Java): dichiarare solo controls/fxml con
             classifier non basta, perché le loro dipendenze transitive su
             base/graphics restano senza classifier e si riauto-risolvono
             di nuovo sulla piattaforma di chi compila. Con tutti e
             quattro i moduli dichiarati esplicitamente per ogni
             piattaforma, lo shade plugin impacchetta le native di tutti
             gli OS nello stesso jar, rendendo clientTK.jar eseguibile
             ovunque indipendentemente da dove è stato compilato.
             Il classifier "mac" (Intel x86_64) è escluso di proposito:
             a differenza di win/mac-aarch64/linux, che hanno estensioni
             di file diverse e quindi convivono senza conflitti nello
             stesso jar, "mac" e "mac-aarch64" impacchettano librerie
             .dylib con lo STESSO nome allo stesso path — nello shade una
             sovrascrive l'altra, e se rimane quella sbagliata l'app
             crasha all'avvio con UnsatisfiedLinkError (verificato: su una
             Mac Apple Silicon con classifier "mac" incluso, restava la
             .dylib x86_64 e falliva). Non esiste un modo per far convivere
             le due varianti macOS in un unico jar shaded. Si copre quindi
             solo mac-aarch64 (Apple Silicon, standard su ogni Mac venduta
             dal 2020 in poi); chi ha ancora un Mac Intel deve ricompilare
             in locale con mvn clean package. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>21.0.2</version>
            <classifier>win</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>21.0.2</version>
            <classifier>mac-aarch64</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>21.0.2</version>
            <classifier>linux</classifier>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>21.0.2</version>
            <classifier>win</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>21.0.2</version>
            <classifier>mac-aarch64</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>21.0.2</version>
            <classifier>linux</classifier>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21.0.2</version>
            <classifier>win</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21.0.2</version>
            <classifier>mac-aarch64</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21.0.2</version>
            <classifier>linux</classifier>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>21.0.2</version>
            <classifier>win</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>21.0.2</version>
            <classifier>mac-aarch64</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>21.0.2</version>
            <classifier>linux</classifier>
        </dependency>

    </dependencies>


    <build>
        <finalName>clientTK</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>

                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>theknife.client.app.TheKnifeClient</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>theknife.client.app.TheKnifeClient</mainClass>
                    <options>
                        <!-- Silenzia il WARNING ripetuto ad ogni avvio su System::load
                             (accesso nativo di javafx-graphics, non un problema nostro).
                             Il WARNING su sun.misc.Unsafe resta: nessun flag per
                             silenziarlo su Java 21, introdotto solo da JDK 23 in poi. -->
                        <option>--enable-native-access=javafx.graphics</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
