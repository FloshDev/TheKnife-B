<?xml version="1.0" encoding="UTF-8"?>
<!-- Layout della schermata gestione recensione (S12). @author Barlera Marco, 760000, VA -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<HBox styleClass="app-shell" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="theknife.client.ui.GestioneRecensioniController">

    <fx:include fx:id="sidebar" source="sidebar.fxml"/>

    <VBox styleClass="main-content, main-content-riempi" HBox.hgrow="ALWAYS">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="tornaIndietroButton" onAction="#handleTornaIndietro" styleClass="bottone-icona">
                <graphic>
                    <SVGPath content="M15 18l-6-6 6-6" fill="TRANSPARENT" stroke="#FA812F" strokeWidth="2.5" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                </graphic>
            </Button>
            <Label text="Gestione recensioni" styleClass="page-title"/>
        </HBox>
        <Label text="Le recensioni di tutti i ristoranti che gestisci." styleClass="page-subtitle"/>

        <ListView fx:id="recensioniListView" styleClass="lista-risultati, lista-risultati-card" VBox.vgrow="ALWAYS"/>
    </VBox>

</HBox>
