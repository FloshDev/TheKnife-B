<?xml version="1.0" encoding="UTF-8"?>
<!-- Layout della schermata dettaglio (S06). @author Barlera Marco, 760000, VA -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox styleClass="page-root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="theknife.client.ui.DettaglioController">

    <VBox styleClass="card, card-lista">
        <Label fx:id="nomeLabel" text="Nome" styleClass="brand-title"/>
        <Label fx:id="tipoCucinaLabel" text="Tipo di cucina" styleClass="dettaglio-info"/>
        <Label fx:id="indirizzoLabel" text="Indirizzo" styleClass="dettaglio-info"/>
        <Label fx:id="fasciaPrezzoLabel" text="Fascia Prezzo" styleClass="dettaglio-info"/>
        <Label fx:id="mediaStelleLabel" text="Media Stelle" styleClass="dettaglio-info"/>

        <ListView fx:id="recensioniListView" styleClass="lista-risultati" VBox.vgrow="ALWAYS"/>

        <Button fx:id="scriviRecensioneButton" text="Scrivi Recensione" onAction="#handleScriviRecensione" styleClass="bottone-primario"/>
        <Button fx:id="preferitiButton" text="Aggiungi ai preferiti" onAction="#handlePreferiti" styleClass="bottone-secondario" graphicTextGap="6">
            <graphic>
                <SVGPath fx:id="cuoreIcon" content="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5" fill="TRANSPARENT" stroke="#FAB12F" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND" scaleX="0.6" scaleY="0.6"/>
            </graphic>
        </Button>
        <HBox alignment="CENTER" spacing="8">
            <Button fx:id="rispondiRecensioneButton" text="Rispondi Recensione" onAction="#handleRispondiRecensione" styleClass="bottone-piccolo"/>
            <Button fx:id="modificaRecensioneButton" text="Modifica Recensione" onAction="#handleModificaRecensione" styleClass="bottone-piccolo"/>
            <Button fx:id="eliminaRecensioneButton" text="Elimina Recensione" onAction="#handleEliminaRecensione" styleClass="bottone-piccolo"/>
        </HBox>
        <Button fx:id="eliminaRistoranteButton" text="Elimina Ristorante" onAction="#handleEliminaRistorante" styleClass="bottone-secondario"/>
        <Button fx:id="tornaIndietroButton" text="Torna Indietro" onAction="#handleTornaIndietro" styleClass="bottone-secondario"/>

    </VBox>

</VBox>