<?xml version="1.0" encoding="UTF-8"?>
<!-- Sidebar di navigazione, inclusa (fx:include) in tutte le schermate autenticate. @author Barlera Marco, 760000, VA -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox styleClass="sidebar" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="theknife.client.ui.SidebarController">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <ImageView fitWidth="56" fitHeight="56" preserveRatio="true" smooth="true">
            <image>
                <Image url="@logoIco.png"/>
            </image>
        </ImageView>
        <Label text="TheKnife" styleClass="sidebar-brand"/>
    </HBox>

    <Region styleClass="divisore"/>

    <VBox spacing="4">
        <Hyperlink fx:id="ricercaItem" text="Ricerca" onAction="#handleRicerca" styleClass="sidebar-nav-item">
            <graphic>
                <Group scaleX="0.6" scaleY="0.6">
                    <Circle centerX="11" centerY="11" radius="8" fill="TRANSPARENT" stroke="#b07840" strokeWidth="2"/>
                    <Line startX="16.65" startY="16.65" endX="21" endY="21" stroke="#b07840" strokeWidth="2" strokeLineCap="ROUND"/>
                </Group>
            </graphic>
        </Hyperlink>
        <Hyperlink fx:id="vicinoAMeItem" text="Vicino a me" onAction="#handleVicinoAMe" styleClass="sidebar-nav-item">
            <graphic>
                <SVGPath content="M12 2a8 8 0 0 0-8 8c0 5.5 8 12 8 12s8-6.5 8-12a8 8 0 0 0-8-8z M12 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" fill="TRANSPARENT" stroke="#b07840" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND" scaleX="0.6" scaleY="0.6"/>
            </graphic>
        </Hyperlink>
        <Hyperlink fx:id="preferitiItem" text="Preferiti" onAction="#handlePreferiti" styleClass="sidebar-nav-item">
            <graphic>
                <SVGPath content="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5" fill="#b07840" scaleX="0.6" scaleY="0.6"/>
            </graphic>
        </Hyperlink>
        <Hyperlink fx:id="dashboardItem" text="Dashboard" onAction="#handleDashboard" styleClass="sidebar-nav-item">
            <graphic>
                <Group scaleX="0.6" scaleY="0.6">
                    <Rectangle x="3" y="3" width="7" height="9" arcWidth="2" arcHeight="2" fill="#b07840"/>
                    <Rectangle x="14" y="3" width="7" height="5" arcWidth="2" arcHeight="2" fill="#b07840"/>
                    <Rectangle x="14" y="12" width="7" height="9" arcWidth="2" arcHeight="2" fill="#b07840"/>
                    <Rectangle x="3" y="16" width="7" height="5" arcWidth="2" arcHeight="2" fill="#b07840"/>
                </Group>
            </graphic>
        </Hyperlink>
        <Hyperlink fx:id="gestisciRecensioniItem" text="Gestisci recensioni" onAction="#handleGestisciRecensioni" styleClass="sidebar-nav-item">
            <graphic>
                <SVGPath content="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" fill="TRANSPARENT" stroke="#b07840" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND" scaleX="0.6" scaleY="0.6"/>
            </graphic>
        </Hyperlink>
        <Hyperlink fx:id="associaRistoranteItem" text="Associati a un ristorante" onAction="#handleAssociaRistorante" styleClass="sidebar-nav-item">
            <graphic>
                <SVGPath content="M9 17H7A5 5 0 0 1 7 7h2 M15 7h2a5 5 0 1 1 0 10h-2 M8 12h8" fill="TRANSPARENT" stroke="#b07840" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND" scaleX="0.6" scaleY="0.6"/>
            </graphic>
        </Hyperlink>
        <Hyperlink fx:id="aggiungiRistoranteItem" text="Aggiungi ristorante" onAction="#handleAggiungiRistorante" styleClass="sidebar-nav-item">
            <graphic>
                <SVGPath content="M12 5v14 M5 12h14" fill="TRANSPARENT" stroke="#b07840" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND" scaleX="0.6" scaleY="0.6"/>
            </graphic>
        </Hyperlink>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <Hyperlink fx:id="aboutItem" text="About" onAction="#handleAbout" styleClass="sidebar-nav-item">
        <graphic>
            <Group scaleX="0.6" scaleY="0.6">
                <Circle centerX="11" centerY="11" radius="9" fill="TRANSPARENT" stroke="#b07840" strokeWidth="2"/>
                <Line startX="11" startY="10" endX="11" endY="16" stroke="#b07840" strokeWidth="2" strokeLineCap="ROUND"/>
                <Circle centerX="11" centerY="6.5" radius="1.2" fill="#b07840"/>
            </Group>
        </graphic>
    </Hyperlink>

    <Region styleClass="divisore"/>

    <HBox fx:id="userBlock" spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="avatarLabel" styleClass="sidebar-avatar"/>
        <VBox spacing="2">
            <Label fx:id="usernameLabel" styleClass="sidebar-username"/>
            <Label fx:id="ruoloLabel" styleClass="sidebar-ruolo"/>
        </VBox>
    </HBox>
    <Hyperlink fx:id="accediLink" text="Accedi" onAction="#handleLogin" styleClass="link-primario"/>

    <Hyperlink fx:id="logoutLink" text="Esci" onAction="#handleLogout" styleClass="sidebar-logout" graphicTextGap="6">
        <graphic>
            <SVGPath content="m16 17 5-5-5-5 M21 12H9 M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" fill="TRANSPARENT" stroke="#FA812F" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND" scaleX="0.6" scaleY="0.6"/>
        </graphic>
    </Hyperlink>

</VBox>
