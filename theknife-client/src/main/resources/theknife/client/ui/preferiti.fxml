                    <Region styleClass="mappa-cella" GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                    <Region styleClass="mappa-cella" GridPane.columnIndex="6" GridPane.rowIndex="1"/>
                    <Region styleClass="mappa-cella" GridPane.columnIndex="7" GridPane.rowIndex="1"/>
                    <Region styleClass="mappa-cella" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
