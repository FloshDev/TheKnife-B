<?xml version="1.0" encoding="UTF-8"?>
<!-- Layout della schermata risultati ricerca (S05). @author Barlera Marco, 760000, VA -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="page-root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="theknife.client.ui.RisultatiController">

    <VBox styleClass="card, card-lista" fx:id="card">
        <Label text="Risultati ricerca" fx:id="risultatiLabel" styleClass="brand-title"/>
        <ListView fx:id="risultatiListView" styleClass="lista-risultati" VBox.vgrow="ALWAYS"/>
        
        <Button fx:id="dettaglioButton" text="Vedi dettaglio" onAction="#handleDettaglio" styleClass="bottone-primario"/>
        <Button fx:id="tornaIndietroButton" text="Torna Indietro" onAction="#handleTornaIndietro" styleClass="bottone-secondario"   />
    </VBox>
</VBox>