<?xml version="1.0" encoding="UTF-8"?>
<!-- Layout della schermata dashboard ristoratore (S09). @author Barlera Marco, 760000, VA -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox styleClass="app-shell" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="theknife.client.ui.DashboardController">

    <fx:include fx:id="sidebar" source="sidebar.fxml"/>

    <VBox styleClass="main-content, main-content-riempi" HBox.hgrow="ALWAYS">

        <Label text="I tuoi ristoranti" styleClass="page-title"/>
        <Label text="Gestisci i locali di cui sei titolare." styleClass="page-subtitle"/>

        <ListView fx:id="ristorantiGestiti" styleClass="lista-risultati, lista-risultati-card" VBox.vgrow="ALWAYS"/>

    </VBox>

</HBox>
